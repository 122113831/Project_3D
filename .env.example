# Salin menjadi .env lalu isi. .env TIDAK ikut ke repositori (lihat .gitignore).

# --- database depot (Oracle) -------------------------------------------------
DEPOT_DB_USER=
DEPOT_DB_PASS=
DEPOT_DB_CONNECT_STRING=host:port/service
DEPOT_DB_LOGGING=true
# Skala peta CORE_YARD_BLOCK.X/Y ke meter. Wajib diisi supaya posisi blok bisa disimpan.
DEPOT_MAP_SCALE=
# Izin menulis (CORE_YARD_BLOCK, YARD_ROWTIER, YARD_LAYOUT). Default mati.
DEPOT_DB_WRITE=false
DEPOT_DB_WRITE_USER=yard3d

# --- aliran kejadian gate (HiveMQ) ------------------------------------------
# Kosongkan MQTT_URL kalau belum ada broker: aplikasi tetap menerima kejadian
# lewat POST /api/yard/events dan pemutar ulang GATE_HIST.
#   HiveMQ Cloud : mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
#   Broker lokal : mqtt://192.168.1.10:1883
MQTT_URL=
MQTT_TOPIC=yard/gate/#
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

# Kalau diisi, POST /api/yard/events wajib membawa header x-events-secret yang sama.
EVENTS_SECRET=
